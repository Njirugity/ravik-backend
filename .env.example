# Copy to .env in the project root (gitignored, never commit it) and fill in your own values.
# For a plain local run, export it into your shell first:
#   set -a && source .env && set +a && ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
# `docker compose up` reads this file natively.
#
# DB_URL — pick ONE depending on how you're running the DB:
#   - Your existing DB on the host machine (default; `docker compose up` alone, no mysql
#     container): jdbc:mysql://host.docker.internal:3306/ravikdb
#   - The bundled throwaway MySQL container (`docker compose --profile localdb up`):
#     jdbc:mysql://mysql:3306/ravikdb
#   - A remote/managed DB: its own jdbc URL, reachable over the network.
DB_URL=jdbc:mysql://host.docker.internal:3306/ravikdb
DB_USERNAME=ravikuser
DB_PASSWORD=

# Generate with: openssl rand -base64 32
JWT_SECRET=

DDL_AUTO=update
SHOW_SQL=true
WEB_LOG_LEVEL=DEBUG
SEED_DEV_DATA=true

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ravik.app

# Only used with `docker compose --profile localdb up` — the bundled MySQL container's own
# root password and the schema/user it creates. Ignored otherwise.
MYSQL_ROOT_PASSWORD=
DB_NAME=ravikdb
