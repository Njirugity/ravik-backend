# Copy to .env in the project root (gitignored, never commit it) and fill in your own values.
# For a plain local run, export it into your shell first:
#   set -a && source .env && set +a && ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
# `docker compose up` reads this file natively (DB_URL is overridden there to point at the
# mysql container).

DB_URL=jdbc:mysql://localhost:3306/ravikdb
DB_USERNAME=ravikuser
DB_PASSWORD=

# Generate with: openssl rand -base64 32
JWT_SECRET=

DDL_AUTO=update
SHOW_SQL=true
WEB_LOG_LEVEL=DEBUG
SEED_DEV_DATA=true

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ravik.app

# docker compose only — MySQL container's own root password and the schema/user it creates.
MYSQL_ROOT_PASSWORD=
DB_NAME=ravikdb
